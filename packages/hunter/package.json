{
  "name": "@terra-incognita/hunter",
  "version": "0.1.0",
  "description": "Solver, bot personalities, an in-memory simulator and a chain client for Terra Incognita hunts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@terra-incognita/core": "^0.1.0",
    "@terra-incognita/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
